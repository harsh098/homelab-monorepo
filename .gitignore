# Terraform / OpenTofu local state and working directories
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.plan
crash.log
crash.*.log

# Keep dependency lock files versioned
!.terraform.lock.hcl

# Variable, environment, and credential material
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
.env
.env.*
*.env
*.env.*
credentials
credentials.*
**/credentials/
*credentials*.json
service-account*.json
*-service-account*.json

# Trilium runtime identity and database files
trilium-tunnel-token
trilium-backup-gcs.json
session_secret.txt
document.db
document.db-*
trilium*.tar.gz
apps/trilium/config.ini
**/trilium-data/

# Kubernetes configuration
kubeconfig
kubeconfig.*
**/kubeconfig
**/kubeconfig.*
*.kubeconfig

# Private keys and certificates
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks

# Plans, logs, retries, and local diagnostics
*.log
*.retry
*.retry.*
*.out

# Local generated XML and temporary artifacts
*.generated.xml
*-generated.xml
*.local.xml
*.tmp.xml
*.temp.xml
*.tmp
*.temp
.tmp/
tmp/
temp/
.debug/
debug/
terraform/layers/02-dns/adguard-managed/conf/
terraform/layers/02-dns/adguard-managed/work/
terraform/layers/02-dns/adguard/conf/
terraform/layers/02-dns/adguard/work/
terraform/layers/03-compute/images/

# Graphify's generated snapshots and rehydratable AST cache
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/cache/ast/
